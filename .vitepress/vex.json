{
  "name": "vex",
  "scopeName": "source.vex",
  "patterns": [
    {
      "name": "keyword.control.vex",
      "match": "\\b(if|else|for|while|return|break|continue|foreach|do)\\b"
    },
    {
      "name": "storage.type.vex",
      "match": "\\b(int|float|vector|matrix|string|dict|struct|void|export)\\b"
    },
    {
      "name": "variable.other.vex",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    },
    {
      "name": "constant.numeric.vex",
      "match": "\\b[0-9.]+\\b"
    }
  ]
}